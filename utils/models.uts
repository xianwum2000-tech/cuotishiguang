export type Preferences = {
	homeTitle: string
	greetingTitle: string
	homeAvatar: string
	statsName: string
}

export type MistakeForm = {
	questionImage: string
	answerImage: string
	subject: string
	chapter: string
	errorType: string
	difficulty: string
	note: string
}

export type Mistake = {
	id: string
	questionImage: string
	answerImage: string
	subject: string
	chapter: string
	errorType: string
	difficulty: string
	note: string
	createdAt: string
	updatedAt: string
	reviewStage: string
	nextReviewDate: string
	totalReviewCount: number
	totalWrongCount: number
	lastReviewResult: string
	isArchived: boolean
}

export type ReviewRecord = {
	id: string
	questionId: string
	reviewDate: string
	result: string
	stageBefore: string
	stageAfter: string
	nextReviewDate: string
}

export type ReviewOutput = {
	success: boolean
	mistake: Mistake
	record: ReviewRecord
}

export type InitialSchedule = {
	reviewStage: string
	nextReviewDate: string
}

export type ReviewSchedule = {
	stageAfter: string
	intervalDays: number
	nextReviewDate: string
}

export type WeeklyBar = {
	date: string
	count: number
	label: string
	height: number
}

export type DistributionItem = {
	name: string
	count: number
	percent: number
}

export function createDefaultPreferences(): Preferences {
	return {
		homeTitle: '复习达人',
		greetingTitle: '早上好，小明',
		homeAvatar: '/static/stitch_assets/avatar-home.jpg',
		statsName: '小明'
	} as Preferences
}

export function createDefaultForm(): MistakeForm {
	return {
		questionImage: '',
		answerImage: '',
		subject: '高数',
		chapter: '极限',
		errorType: '思路错',
		difficulty: '中等',
		note: ''
	} as MistakeForm
}

export function createEmptyMistake(): Mistake {
	return {
		id: '',
		questionImage: '',
		answerImage: '',
		subject: '',
		chapter: '',
		errorType: '',
		difficulty: '',
		note: '',
		createdAt: '',
		updatedAt: '',
		reviewStage: 'new',
		nextReviewDate: '',
		totalReviewCount: 0,
		totalWrongCount: 0,
		lastReviewResult: '',
		isArchived: false
	} as Mistake
}

export function createEmptyReviewRecord(): ReviewRecord {
	return {
		id: '',
		questionId: '',
		reviewDate: '',
		result: '',
		stageBefore: '',
		stageAfter: '',
		nextReviewDate: ''
	} as ReviewRecord
}

export function createEmptyReviewOutput(): ReviewOutput {
	return {
		success: false,
		mistake: createEmptyMistake(),
		record: createEmptyReviewRecord()
	} as ReviewOutput
}
